# Copy to .env for optional cloud voice features. Never commit a real key.
DASHSCOPE_API_KEY=

# `demo` runs without ESP32, camera, models, or cloud credentials.
AIGLASSES_MODE=demo
AIGLASSES_HOST=127.0.0.1
AIGLASSES_PORT=8081

# Local camera path. `heuristic` needs OpenCV and no weight file.
# `yolox` needs the optional download. `auto` uses YOLOX only when the file exists.
# AIGLASSES_VISION=heuristic
# AIGLASSES_WEIGHTS=

# Spoken guidance is off unless set. `edge` sends the sentence (not the image)
# to Microsoft's speech service. `pyttsx3` stays on the machine.
# AIGLASSES_TTS=none

# Required only when AIGLASSES_MODE=hardware. Keep this value private.
DEVICE_INGEST_TOKEN=
DEVICE_MAX_REQUESTS_PER_MINUTE=120
